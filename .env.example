# 服务器配置
NODE_ENV=dev
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=sqlstudy

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 加密密钥（生产环境请使用强随机字符串）
# AES 对称加密密钥，16位
AES_KEY=your_16_char_aes_key
# AES IV，16位
AES_IV=your_16_char_aes_iv

# RSA 私钥（多行内容，请保持格式）
# 请将从密钥管理服务获取的私钥填入此处，注意保留换行
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
Your Private Key Here
-----END RSA PRIVATE KEY-----

# JWT 配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 日志级别
LOG_LEVEL=debug